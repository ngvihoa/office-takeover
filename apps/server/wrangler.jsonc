{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "office-takeover",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  // Existing workers.dev hostname is protected by a self-hosted Access application.
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "EMBED_ALLOWED_ORIGINS": "" },
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "TELEMETRY_DB",
      "database_name": "office-takeover-telemetry",
      // Production D1 (APAC). Local dev and tests use a local D1, never this one.
      "database_id": "74e2c0c4-a21d-49fd-812b-da85611f6564",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "observability": { "enabled": false }
}
