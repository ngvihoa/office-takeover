{
  "name": "@ot/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply TELEMETRY_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply TELEMETRY_DB --remote"
  },
  "dependencies": {
    "@ot/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261108.1",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "wrangler": "4.158.0"
  }
}
