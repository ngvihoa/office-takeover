{
  "name": "office-takeover",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm art:build && pnpm --filter @ot/client dev",
    "build": "pnpm art:build && pnpm --filter @ot/client build && pnpm --filter @ot/server build",
    "deploy": "pnpm build && pnpm --filter @ot/server deploy",
    "art:build": "tsx art/scripts/build.ts",
    "art:sfx": "tsx art/scripts/build-sfx.ts",
    "art:validate": "tsx art/scripts/validate.ts source && tsx art/scripts/validate.ts output",
    "art:typecheck": "tsc -p art/tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -b && pnpm art:typecheck",
    "lint": "biome check . --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "happy-dom": "^21.0.4",
    "jsfxr": "1.4.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
